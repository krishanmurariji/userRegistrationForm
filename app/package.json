{
  "name": "app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "mobile:android": "ng build --configuration production && cap sync android",
    "mobile:android:dev": "cross-env CAP_DEV=1 ng build --configuration android-dev && cross-env CAP_DEV=1 cap sync android",
    "mobile:ios": "ng build --configuration production && cap sync ios",
    "mobile:ios:dev": "cross-env CAP_DEV=1 ng build --configuration development && cross-env CAP_DEV=1 cap sync ios",
    "mobile:assets": "capacitor-assets generate --android --ios --assetPath assets",
    "open:android": "cap open android",
    "open:ios": "cap open ios"
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@azure/msal-browser": "^5.29.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@ionic/angular": "^9.0.11",
    "@phosphor-icons/core": "^2.1.1",
    "ionicons": "^8.1.0",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@types/qrcode": "^1.5.6",
    "cross-env": "^10.1.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
