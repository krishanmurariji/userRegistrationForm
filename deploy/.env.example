# Copy to .env and fill in. Never commit .env.
# Your address, without https://. A free one: yourname.duckdns.org (see docs/DEPLOY.md)
DOMAIN=
# Database password: any long random text without spaces, quotes or semicolons.
DB_PASSWORD=
# Signs login tokens. At least 32 random characters. Never change it later (everyone would be signed out).
JWT_KEY=
# The platform admin, created the first time the API starts.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional: where the web app lives (default is https://DOMAIN)
CLIENT_URL=
# Optional: real emails (Zoho: smtp.zoho.in or smtp.zoho.com, port 587)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# Optional: adding items from a photo
OPENAI_API_KEY=
