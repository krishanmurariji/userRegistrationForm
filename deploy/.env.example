# Copy to .env and fill in. Never commit .env.
# How the API reaches the internet: "tunnel" (Cloudflare Tunnel, for a PC at home) or "server" (Caddy, needs a public IP)
COMPOSE_PROFILES=tunnel
# tunnel: the token Cloudflare shows when you create the tunnel (docs/DEPLOY.md)
TUNNEL_TOKEN=
# server: your address without https://, for example api.example.com or yourname.duckdns.org
DOMAIN=
# Database password: any long random text without spaces, quotes or semicolons.
DB_PASSWORD=
# Signs login tokens. At least 32 random characters. Never change it later (everyone would be signed out).
JWT_KEY=
# The platform admin, created the first time the API starts.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Where the web app lives. With a tunnel, set this to your API address, for example https://api.example.com
# (it is used in the links inside emails).
CLIENT_URL=
# Optional: real emails (Zoho: smtp.zoho.in or smtp.zoho.com, port 587)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# Optional: adding items from a photo
OPENAI_API_KEY=
